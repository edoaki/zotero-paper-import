{
  "name": "zotero-paper-import",
  "version": "0.3.4",
  "private": true,
  "description": "Zoteroの論文をノートとPDFで取り込み、未整理をAIで分類。分類先の変更、既存ノートのZoteroキー補完に対応します。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "obsidian": "1.13.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  }
}
